      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(centralwatch_http_server_duration_milliseconds_sum{job=~\"$job\", instance=~\"$instance\", service=~\"$service\", deployment_environment=~\"$environment\"}[$__rate_interval])) / sum(rate(centralwatch_http_server_duration_milliseconds_count{job=~\"$job\", instance=~\"$instance\", service=~\"$service\", deployment_environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
