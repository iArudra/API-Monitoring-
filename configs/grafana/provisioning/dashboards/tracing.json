      },
      "id": 1,
      "description": "Search and inspect traces for the selected service.",
      "panels": [],
      "title": "Trace Search",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "description": "Most recent traces for the selected service. Click a row to render it in the Trace Waterfall.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
